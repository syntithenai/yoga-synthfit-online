      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 3.241
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.198
    },
    {
      "index": 6,
      "text": "Longer breath out.",
