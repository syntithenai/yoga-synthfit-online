      "durationSec": 4.162
    },
    {
      "index": 14,
      "text": "Not forcing feeling. Just locating the space.",
      "file": "c014.ogg",
      "durationSec": 5.267
    },
    {
      "index": 15,
      "text": "[pause:31]",
      "file": "c015.ogg",
      "durationSec": 31.0,
      "silence": true
