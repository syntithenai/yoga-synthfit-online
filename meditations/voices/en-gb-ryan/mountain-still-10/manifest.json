      "text": "Imagine yourself as a mountain.",
      "file": "c013.ogg",
      "durationSec": 3.404
    },
    {
      "index": 14,
      "text": "Base wide. Peak quiet. Vast patience.",
      "file": "c014.ogg",
      "durationSec": 5.21
    },
    {
      "index": 15,
      "text": "[pause:43]",
      "file": "c015.ogg",
      "durationSec": 43.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Weather moves across the mountain.",
      "file": "c016.ogg",
      "durationSec": 3.361
    },
    {
      "index": 17,
      "text": "Sun. Wind. Cloud. Storm.",
      "file": "c017.ogg",
      "durationSec": 3.757
