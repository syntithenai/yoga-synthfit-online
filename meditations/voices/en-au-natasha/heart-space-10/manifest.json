    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 2.76
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "Sit or lie down with support.",
      "file": "c002.ogg",
      "durationSec": 4.848
    },
    {
      "index": 3,
      "text": "Close the eyes if that feels safe.",
      "file": "c003.ogg",
      "durationSec": 5.16
    },
    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 4.56
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 3.456
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
      "durationSec": 3.648
    },
    {
      "index": 7,
      "text": "[pause:25]",
      "file": "c007.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 2.568
    },
    {
      "index": 9,
      "text": "[pause:25]",
      "file": "c009.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 3.888
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
      "durationSec": 3.696
    },
    {
      "index": 12,
      "text": "[pause:31]",
      "file": "c012.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Bring attention to the center of the chest.",
      "file": "c013.ogg",
      "durationSec": 5.496
    },
    {
      "index": 14,
      "text": "Not forcing feeling. Just locating the space.",
      "file": "c014.ogg",
      "durationSec": 8.352
    },
    {
      "index": 15,
      "text": "[pause:31]",
      "file": "c015.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Breathe as if the inhale enters through the heart.",
      "file": "c016.ogg",
      "durationSec": 6.168
    },
    {
      "index": 17,
      "text": "As if the exhale softens the heart from inside.",
      "file": "c017.ogg",
      "durationSec": 6.432
    },
    {
      "index": 18,
      "text": "[pause:37]",
      "file": "c018.ogg",
      "durationSec": 37.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "If emotion arises, let it move like weather.",
      "file": "c019.ogg",
      "durationSec": 6.36
    },
    {
      "index": 20,
      "text": "[pause:37]",
      "file": "c020.ogg",
      "durationSec": 37.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Silently: may my heart be at ease.",
      "file": "c021.ogg",
      "durationSec": 5.784
    },
    {
      "index": 22,
      "text": "[pause:31]",
      "file": "c022.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "May I be patient with my own timing.",
      "file": "c023.ogg",
      "durationSec": 5.544
    },
    {
      "index": 24,
      "text": "[pause:31]",
      "file": "c024.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 25,
      "text": "Bring to mind someone easy to care about.",
      "file": "c025.ogg",
      "durationSec": 6.0
    },
    {
      "index": 26,
      "text": "Wish them ease.",
      "file": "c026.ogg",
      "durationSec": 3.264
    },
    {
      "index": 27,
      "text": "May you be at ease.",
      "file": "c027.ogg",
      "durationSec": 3.72
    },
    {
      "index": 28,
      "text": "[pause:37]",
      "file": "c028.ogg",
      "durationSec": 37.0,
      "silence": true
    },
    {
      "index": 29,
      "text": "Return to your own heart space.",
      "file": "c029.ogg",
      "durationSec": 5.28
    },
    {
      "index": 30,
      "text": "Warm. Spacious. Human.",
