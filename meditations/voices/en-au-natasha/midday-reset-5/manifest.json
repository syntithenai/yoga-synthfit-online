{
  "id": "midday-reset-5",
  "voiceId": "en-au-natasha",
  "edgeVoice": "en-AU-NatashaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 319,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 2.76
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 7.608
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 4.032
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 5.088
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 3.888
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 3.888
    },
    {
      "index": 6,
      "text": "Let the morning end here, even if the day continues.",
      "file": "c006.ogg",
      "durationSec": 7.056
    },
    {
      "index": 7,
      "text": "Drop the shoulders.",
      "file": "c007.ogg",
      "durationSec": 3.672
    },
    {
      "index": 8,
      "text": "Unclench the jaw.",
      "file": "c008.ogg",
      "durationSec": 3.672
    },
    {
      "index": 9,
      "text": "[pause:30]",
      "file": "c009.ogg",
      "durationSec": 30.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Inhale through the nose.",
      "file": "c010.ogg",
      "durationSec": 4.104
    },
    {
      "index": 11,
      "text": "Exhale through the mouth, as if fogging a window.",
      "file": "c011.ogg",
      "durationSec": 6.432
    },
    {
      "index": 12,
      "text": "Again.",
      "file": "c012.ogg",
      "durationSec": 2.568
    },
    {
      "index": 13,
      "text": "[pause:30]",
      "file": "c013.ogg",
      "durationSec": 30.0,
      "silence": true
    },
    {
      "index": 14,
      "text": "Imagine setting down whatever you were carrying.",
      "file": "c014.ogg",
      "durationSec": 5.88
    },
    {
      "index": 15,
      "text": "It can wait on the table beside you.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "[pause:37]",
      "file": "c016.ogg",
      "durationSec": 37.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Feel the spine tall.",
      "file": "c017.ogg",
      "durationSec": 4.104
    },
    {
      "index": 18,
      "text": "Feel the belly soft.",
      "file": "c018.ogg",
      "durationSec": 3.864
    },
    {
      "index": 19,
      "text": "[pause:30]",
      "file": "c019.ogg",
      "durationSec": 30.0,
      "silence": true
    },
    {
      "index": 20,
      "text": "Ask quietly: what matters in the next hour?",
      "file": "c020.ogg",
      "durationSec": 6.48
    },
    {
      "index": 21,
      "text": "One clear next step is enough.",
      "file": "c021.ogg",
      "durationSec": 5.04
    },
    {
      "index": 22,
      "text": "[pause:44]",
      "file": "c022.ogg",
      "durationSec": 44.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Breathe that simplicity in.",
      "file": "c023.ogg",
      "durationSec": 4.248
    },
    {
      "index": 24,
      "text": "Breathe effort out.",
      "file": "c024.ogg",
      "durationSec": 3.6
    },
    {
      "index": 25,
      "text": "[pause:37]",
      "file": "c025.ogg",
      "durationSec": 37.0,
      "silence": true
    },
    {
      "index": 26,
      "text": "Take one more easy breath.",
      "file": "c026.ogg",
      "durationSec": 4.56
    },
    {
      "index": 27,
      "text": "Wiggle the fingers.",
      "file": "c027.ogg",
      "durationSec": 3.6
    },
    {
      "index": 28,
      "text": "When you are ready, open the eyes.",
      "file": "c028.ogg",
      "durationSec": 5.256
    },
    {
      "index": 29,
      "text": "Carry a little of this with you.",
      "file": "c029.ogg",
      "durationSec": 4.248
    }
  ],
  "engine": "edge",
  "note": "edge-tts bake for practice pack; optional elevenlabs re-bake later"
}
