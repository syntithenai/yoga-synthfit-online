{
  "id": "forest-path-10",
  "voiceId": "es-elvira",
  "edgeVoice": "es-ES-ElviraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 675,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "Encuentra una postura que no te pida nada.",
      "file": "c001.ogg",
      "durationSec": 5.664
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con el apoyo que necesites.",
      "file": "c002.ogg",
      "durationSec": 6.576
    },
    {
      "index": 3,
      "text": "Deja que tus manos descansen abiertas o suaves.",
      "file": "c003.ogg",
      "durationSec": 6.528
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 6.36
    },
    {
      "index": 5,
      "text": "Siente los lugares donde tu cuerpo se encuentra con el suelo.",
      "file": "c005.ogg",
      "durationSec": 6.912
    },
    {
      "index": 6,
      "text": "Los talones, los isquiones, la parte posterior de la cabeza o la longitud de la columna.",
      "file": "c006.ogg",
      "durationSec": 9.768
    },
    {
      "index": 7,
      "text": "No hay nada que retrasar ahora.",
      "file": "c007.ogg",
      "durationSec": 4.728
    },
    {
      "index": 8,
      "text": "Respire lentamente por la nariz.",
      "file": "c008.ogg",
      "durationSec": 5.112
    },
    {
      "index": 9,
      "text": "Siente el frescor del aire llegando.",
      "file": "c009.ogg",
      "durationSec": 5.112
    },
    {
      "index": 10,
      "text": "Y exhale un poco más.",
      "file": "c010.ogg",
      "durationSec": 4.128
    },
    {
      "index": 11,
      "text": "Siente el calor de la exhalación al irse.",
      "file": "c011.ogg",
      "durationSec": 5.592
    },
    {
      "index": 12,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c012.ogg",
      "durationSec": 6.384
    },
    {
      "index": 13,
      "text": "Exhala sin prisas.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Deja que los hombros caigan una fracción.",
      "file": "c014.ogg",
      "durationSec": 5.352
    },
    {
      "index": 15,
      "text": "Deja que la mandíbula se afloje.",
      "file": "c015.ogg",
      "durationSec": 4.848
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 3.936
    },
    {
      "index": 17,
      "text": "Quédate con tres respiraciones tranquilas, tal como están.",
      "file": "c017.ogg",
      "durationSec": 7.08
    },
    {
      "index": 18,
      "text": "Inhalar. Llegar.",
      "file": "c018.ogg",
      "durationSec": 5.16
    },
    {
      "index": 19,
      "text": "Exhalar. Asentarse.",
      "file": "c019.ogg",
      "durationSec": 5.784
    },
    {
      "index": 20,
      "text": "Si la mente divaga, obsérvalo con amabilidad y regresa a esta respiración.",
      "file": "c020.ogg",
      "durationSec": 8.904
    },
    {
      "index": 21,
      "text": "Ahora comience una caminata lenta hacia un bosque viejo.",
      "file": "c021.ogg",
      "durationSec": 6.912
    },
    {
      "index": 22,
      "text": "El camino está suave con agujas y hojas caídas.",
      "file": "c022.ogg",
      "durationSec": 6.504
    },
    {
      "index": 23,
      "text": "Cada paso produce un sonido suave, luego regresa el silencio.",
      "file": "c023.ogg",
      "durationSec": 7.848
    },
    {
      "index": 24,
      "text": "La luz del sol se filtra a través de las ramas altas en cálidas cintas.",
      "file": "c024.ogg",
      "durationSec": 8.304
    },
    {
      "index": 25,
      "text": "Siente una mancha de sol en tu antebrazo: un calor suave y repentino.",
      "file": "c025.ogg",
      "durationSec": 8.688
    },
    {
      "index": 26,
      "text": "Luego sombree nuevamente, fresco y verde.",
      "file": "c026.ogg",
      "durationSec": 6.048
    },
    {
      "index": 27,
      "text": "A breeze moves the canopy. Fresh air finds your face.",
      "file": "c027.ogg",
      "durationSec": 8.208
    },
    {
      "index": 28,
      "text": "Huele a resina, a tierra húmeda y a la limpia dulzura del musgo.",
      "file": "c028.ogg",
      "durationSec": 7.92
    },
    {
      "index": 29,
      "text": "Pausa. Coloque una palma sobre la corteza rugosa.",
      "file": "c029.ogg",
      "durationSec": 8.256
    },
    {
      "index": 30,
      "text": "Feel the tree’s stillness enter your hand.",
      "file": "c030.ogg",
      "durationSec": 5.232
    },
    {
      "index": 31,
      "text": "Continúe más profundamente. Los sonidos del mundo exterior se desvanecen.",
      "file": "c031.ogg",
      "durationSec": 10.296
    },
    {
      "index": 32,
      "text": "En algún lugar, un arroyo habla con pequeñas sílabas brillantes.",
      "file": "c032.ogg",
      "durationSec": 7.944
    },
    {
      "index": 33,
      "text": "Se sigue hasta que aparece agua entre las piedras.",
      "file": "c033.ogg",
      "durationSec": 6.288
    },
    {
      "index": 34,
      "text": "Arrodillarse. Sumerge tus manos. Genial claridad.",
      "file": "c034.ogg",
      "durationSec": 10.32
    },
    {
      "index": 35,
      "text": "Salpica un poco en tus muñecas. El frescor despierta la piel.",
      "file": "c035.ogg",
      "durationSec": 9.288
    },
    {
      "index": 36,
      "text": "Siéntate en una roca plana calentada por una estrecha columna de sol.",
      "file": "c036.ogg",
      "durationSec": 8.088
    },
    {
      "index": 37,
      "text": "Siente ese calor en los isquiones y en la parte posterior de los muslos.",
      "file": "c037.ogg",
      "durationSec": 8.304
    },
    {
      "index": 38,
      "text": "Siente el aliento fresco del arroyo contra tus espinillas.",
      "file": "c038.ogg",
      "durationSec": 7.152
    },
    {
      "index": 39,
      "text": "Los pájaros cantan una vez y luego abandonan el silencio nuevamente.",
      "file": "c039.ogg",
      "durationSec": 8.112
    },
    {
      "index": 40,
      "text": "Respire la frescura del bosque.",
      "file": "c040.ogg",
      "durationSec": 4.92
    },
    {
      "index": 41,
      "text": "Exhale hacia los troncos de pacientes que lo rodean.",
      "file": "c041.ogg",
      "durationSec": 6.336
    },
    {
      "index": 42,
      "text": "Observa cómo tus hombros han caído sin que te lo pidan.",
      "file": "c042.ogg",
      "durationSec": 6.36
    },
    {
      "index": 43,
      "text": "Cómo se ablanda la mandíbula cuando no hay otro lugar donde estar.",
      "file": "c043.ogg",
      "durationSec": 7.2
    },
    {
      "index": 44,
      "text": "Ponte de pie cuando estés listo y camina un poco más.",
      "file": "c044.ogg",
      "durationSec": 6.408
    },
    {
      "index": 45,
      "text": "Los helechos rozan tus pantorrillas con las frescas y verdes yemas de tus dedos.",
      "file": "c045.ogg",
      "durationSec": 9.072
    },
    {
      "index": 46,
      "text": "Se abre un claro, redondo como un suspiro contenido.",
      "file": "c046.ogg",
      "durationSec": 7.152
    },
    {
      "index": 47,
      "text": "Recuéstese sobre musgo profundo.",
      "file": "c047.ogg",
      "durationSec": 5.136
    },
    {
      "index": 48,
      "text": "La tierra recibe tu peso por completo.",
      "file": "c048.ogg",
      "durationSec": 5.568
    },
    {
      "index": 49,
      "text": "Calor del sol filtrado en tu rostro.",
      "file": "c049.ogg",
      "durationSec": 5.184
    },
    {
      "index": 50,
      "text": "Frescura del musgo a lo largo de tu columna.",
      "file": "c050.ogg",
      "durationSec": 5.904
    },
    {
      "index": 51,
      "text": "La brisa llega, se va, vuelve a llegar.",
      "file": "c051.ogg",
      "durationSec": 5.52
    },
    {
      "index": 52,
      "text": "Quédate con la sensación de estar sostenido por un lugar vivo.",
      "file": "c052.ogg",
      "durationSec": 7.2
    },
    {
      "index": 53,
      "text": "Seguro. Tranquilo. Pertenecer sin esfuerzo.",
      "file": "c053.ogg",
      "durationSec": 9.528
    },
    {
      "index": 54,
      "text": "Cuente cinco respiraciones lentas aquí, cada una más suave.",
      "file": "c054.ogg",
      "durationSec": 7.608
    },
    {
      "index": 55,
      "text": "Notice scent again — green, damp, honest.",
      "file": "c055.ogg",
      "durationSec": 6.12
    },
    {
      "index": 56,
      "text": "Observe el sonido nuevamente: casi ninguno, y eso es suficiente.",
      "file": "c056.ogg",
      "durationSec": 8.448
    },
    {
      "index": 57,
      "text": "Si aparece un pensamiento, déjalo flotar como una hoja en la corriente.",
      "file": "c057.ogg",
      "durationSec": 8.52
    },
    {
      "index": 58,
      "text": "Vuelve al calor en la piel allí donde te encuentre el sol.",
      "file": "c058.ogg",
      "durationSec": 6.456
    },
    {
      "index": 59,
      "text": "Return to coolness in the shade between those warm ribbons.",
      "file": "c059.ogg",
      "durationSec": 7.008
    },
    {
      "index": 60,
      "text": "Has caminado lo suficiente hacia adentro.",
      "file": "c060.ogg",
      "durationSec": 5.568
    },
    {
      "index": 61,
      "text": "Deja que tres respiraciones lentas sellen esto en el cuerpo.",
      "file": "c061.ogg",
      "durationSec": 7.008
    },
    {
      "index": 62,
      "text": "Before you leave, stand once more at the stream.",
      "file": "c062.ogg",
      "durationSec": 6.096
    },
    {
      "index": 63,
      "text": "Watch clear water braid around stones.",
      "file": "c063.ogg",
      "durationSec": 5.712
    },
    {
      "index": 64,
      "text": "El aire frío se eleva desde la superficie en movimiento.",
      "file": "c064.ogg",
      "durationSec": 6.864
    },
    {
      "index": 65,
      "text": "La luz cálida todavía llega a una franja de tu antebrazo.",
      "file": "c065.ogg",
      "durationSec": 7.152
    },
    {
      "index": 66,
      "text": "Taza de agua y humedece la frente si lo deseas: en la imaginación, fresca y amable.",
      "file": "c066.ogg",
      "durationSec": 9.648
    },
    {
      "index": 67,
      "text": "El bosque no aplaude. Simplemente continúa.",
      "file": "c067.ogg",
      "durationSec": 7.776
    },
    {
      "index": 68,
      "text": "That continuance is a teacher.",
      "file": "c068.ogg",
      "durationSec": 4.752
    },
    {
      "index": 69,
      "text": "Camine por el camino hacia afuera con unos pocos pasos silenciosos en la mente.",
      "file": "c069.ogg",
      "durationSec": 8.712
    },
    {
      "index": 70,
      "text": "Agujas bajo los pies. Sonido suave. Regreso suave.",
      "file": "c070.ogg",
      "durationSec": 11.016
    },
    {
      "index": 71,
      "text": "Yet the clearing’s peace stays in the chest like stored sun.",
      "file": "c071.ogg",
      "durationSec": 6.864
    },
    {
      "index": 72,
      "text": "Siéntelo allí: calidez detrás del esternón.",
      "file": "c072.ogg",
      "durationSec": 6.432
    },
    {
      "index": 73,
      "text": "Feel freshness still at the nostrils.",
      "file": "c073.ogg",
      "durationSec": 5.376
    },
    {
      "index": 74,
      "text": "Puedes llevar ambos a habitaciones normales.",
      "file": "c074.ogg",
      "durationSec": 5.976
    },
    {
      "index": 75,
      "text": "Una última mirada a través de las ramas hacia una moneda de cielo.",
      "file": "c075.ogg",
      "durationSec": 7.632
    },
    {
      "index": 76,
      "text": "Suficiente.",
      "file": "c076.ogg",
      "durationSec": 3.144
    },
    {
      "index": 77,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c077.ogg",
      "durationSec": 6.864
    },
    {
      "index": 78,
      "text": "Inhale the freshness of this place.",
      "file": "c078.ogg",
      "durationSec": 5.208
    },
    {
      "index": 79,
      "text": "Exhala hacia su calidez y tranquilidad.",
      "file": "c079.ogg",
      "durationSec": 5.376
    },
    {
      "index": 80,
      "text": "Inhalar.",
      "file": "c080.ogg",
      "durationSec": 2.664
    },
    {
      "index": 81,
      "text": "Exhale.",
      "file": "c081.ogg",
      "durationSec": 2.784
    },
    {
      "index": 82,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c082.ogg",
      "durationSec": 6.384
    },
    {
      "index": 83,
      "text": "Longer exhale.",
      "file": "c083.ogg",
      "durationSec": 3.408
    },
    {
      "index": 84,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c084.ogg",
      "durationSec": 6.648
    },
    {
      "index": 85,
      "text": "Inhalar.",
      "file": "c085.ogg",
      "durationSec": 2.664
    },
    {
      "index": 86,
      "text": "Exhale.",
      "file": "c086.ogg",
      "durationSec": 2.784
    },
    {
      "index": 87,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c087.ogg",
      "durationSec": 6.336
    },
    {
      "index": 88,
      "text": "O para enfriar el aire en la nariz.",
      "file": "c088.ogg",
      "durationSec": 4.848
    },
    {
      "index": 89,
      "text": "Inhalar.",
      "file": "c089.ogg",
      "durationSec": 2.664
    },
    {
      "index": 90,
      "text": "Exhale.",
      "file": "c090.ogg",
      "durationSec": 2.784
    },
    {
      "index": 91,
      "text": "Inhalar.",
      "file": "c091.ogg",
      "durationSec": 2.664
    },
    {
      "index": 92,
      "text": "Exhalar.",
      "file": "c092.ogg",
      "durationSec": 2.808
    },
    {
      "index": 93,
      "text": "Permanecer. Ablandar. Continuar.",
      "file": "c093.ogg",
      "durationSec": 8.352
    },
    {
      "index": 94,
      "text": "Inhalar.",
      "file": "c094.ogg",
      "durationSec": 2.664
    },
    {
      "index": 95,
      "text": "Exhale.",
      "file": "c095.ogg",
      "durationSec": 2.784
    },
    {
      "index": 96,
      "text": "One more easy cycle.",
      "file": "c096.ogg",
      "durationSec": 3.888
    },
    {
      "index": 97,
      "text": "Inhale.",
      "file": "c097.ogg",
      "durationSec": 2.64
    },
    {
      "index": 98,
      "text": "Exhale.",
      "file": "c098.ogg",
      "durationSec": 2.784
    },
    {
      "index": 99,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c099.ogg",
      "durationSec": 5.904
    },
    {
      "index": 100,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c100.ogg",
      "durationSec": 8.616
    },
    {
      "index": 101,
      "text": "Puedes regresar a este lugar cuando lo necesites.",
      "file": "c101.ogg",
      "durationSec": 6.288
    },
    {
      "index": 102,
      "text": "Vive en tu atención, no sólo en tu imaginación.",
      "file": "c102.ogg",
      "durationSec": 6.432
    },
    {
      "index": 103,
      "text": "Comience a profundizar la respiración.",
      "file": "c103.ogg",
      "durationSec": 5.328
    },
    {
      "index": 104,
      "text": "Vuelve a sentir la habitación que te rodea.",
      "file": "c104.ogg",
      "durationSec": 5.712
    },
    {
      "index": 105,
      "text": "Mueve los dedos. Suaviza los dedos de los pies.",
      "file": "c105.ogg",
      "durationSec": 8.136
    },
    {
      "index": 106,
      "text": "When you are ready, open your eyes.",
      "file": "c106.ogg",
      "durationSec": 5.496
    },
    {
      "index": 107,
      "text": "Respira tranquilamente una vez más.",
      "file": "c107.ogg",
      "durationSec": 5.544
    },
    {
      "index": 108,
      "text": "Lleva esta calma a lo que venga después.",
      "file": "c108.ogg",
      "durationSec": 5.568
    }
  ]
}
