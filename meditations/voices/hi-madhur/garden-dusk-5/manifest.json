{
  "id": "garden-dusk-5",
  "voiceId": "hi-madhur",
  "edgeVoice": "hi-IN-MadhurNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 403,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.192
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "Allow your eyes to close, or soften your gaze.",
      "file": "c003.ogg",
      "durationSec": 7.296
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.808
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 5.616
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 5.736
    },
    {
      "index": 7,
      "text": "Again. Soft inhale.",
      "file": "c007.ogg",
      "durationSec": 5.688
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.536
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.328
    },
    {
      "index": 10,
      "text": "नरम शाम के समय एक शांत दीवारों वाले बगीचे की कल्पना करें।",
      "file": "c010.ogg",
      "durationSec": 9.504
    },
    {
      "index": 11,
      "text": "पत्थर के रास्ते दिन की आखिरी गर्माहट बरकरार रखते हैं।",
      "file": "c011.ogg",
      "durationSec": 9.048
    },
    {
      "index": 12,
      "text": "अपने पैरों के तलवों के माध्यम से उस हल्की गर्मी को महसूस करें।",
      "file": "c012.ogg",
      "durationSec": 9.384
    },
    {
      "index": 13,
      "text": "लैवेंडर और शाम के गुलाब एक शांत सुगंध छोड़ते हैं।",
      "file": "c013.ogg",
      "durationSec": 9.144
    },
    {
      "index": 14,
      "text": "A cool breeze slips over the wall and cools your neck.",
      "file": "c014.ogg",
      "durationSec": 8.136
    },
    {
      "index": 15,
      "text": "गर्म दोपहर के बाद हवा ताज़ा है।",
      "file": "c015.ogg",
      "durationSec": 6.624
    },
    {
      "index": 16,
      "text": "आप सांसों की तरह मुलायम छंटे हुए बाड़ों के बीच धीरे-धीरे चलते हैं।",
      "file": "c016.ogg",
      "durationSec": 10.992
    },
    {
      "index": 17,
      "text": "आपकी उंगलियाँ अभी भी सूरज को थामे हुए पत्तों को ब्रश करती हैं।",
      "file": "c017.ogg",
      "durationSec": 10.224
    },
    {
      "index": 18,
      "text": "Warm. Smooth. Alive.",
      "file": "c018.ogg",
      "durationSec": 7.32
    },
    {
      "index": 19,
      "text": "एक शांत पेड़ के नीचे एक लकड़ी की बेंच इंतज़ार कर रही है।",
      "file": "c019.ogg",
      "durationSec": 9.936
    },
    {
      "index": 20,
      "text": "तुम बैठो. लकड़ी आपकी पीठ पर सुखद रूप से गर्म होती है।",
      "file": "c020.ogg",
      "durationSec": 11.448
    },
    {
      "index": 21,
      "text": "Above, the sky turns lavender and rose.",
      "file": "c021.ogg",
      "durationSec": 7.128
    },
    {
      "index": 22,
      "text": "Birds settle. The garden grows hush.",
      "file": "c022.ogg",
      "durationSec": 7.584
    },
    {
      "index": 23,
      "text": "पत्थर और लकड़ी से गर्माहट कम होती हुई महसूस करें।",
      "file": "c023.ogg",
      "durationSec": 8.232
    },
    {
      "index": 24,
      "text": "शाम की ताज़ा ठंडक को अपने चेहरे पर महसूस करें।",
      "file": "c024.ogg",
      "durationSec": 8.064
    },
    {
      "index": 25,
      "text": "गंध और शांति को अंदर लें।",
      "file": "c025.ogg",
      "durationSec": 5.544
    },
    {
      "index": 26,
      "text": "जिस दिन आपने सांस अंदर ली थी उसी दिन सांस छोड़ें।",
      "file": "c026.ogg",
      "durationSec": 8.568
    },
    {
      "index": 27,
      "text": "एक पतंगा आखिरी सुनहरी रोशनी से होकर गुजरता है।",
      "file": "c027.ogg",
      "durationSec": 8.88
    },
    {
      "index": 28,
      "text": "Nothing here is urgent. Everything is enough.",
      "file": "c028.ogg",
      "durationSec": 8.544
    },
    {
      "index": 29,
      "text": "उस पर्याप्तता में आराम करो.",
      "file": "c029.ogg",
      "durationSec": 5.304
    },
    {
      "index": 30,
      "text": "अपने पेट को शाम की हवा में नरम होने दें।",
      "file": "c030.ogg",
      "durationSec": 6.984
    },
    {
      "index": 31,
      "text": "Let your next breath be the quietest of the day.",
      "file": "c031.ogg",
      "durationSec": 6.864
    },
    {
      "index": 32,
      "text": "Walk one slow loop of the path before you finish.",
      "file": "c032.ogg",
      "durationSec": 7.392
    },
    {
      "index": 33,
      "text": "गर्म पत्थर पैरों के नीचे ठंडे हो रहे हैं।",
      "file": "c033.ogg",
      "durationSec": 7.872
    },
    {
      "index": 34,
      "text": "हेजेज दिन भर का संग्रहित इत्र जारी कर रहे हैं।",
      "file": "c034.ogg",
      "durationSec": 8.28
    },
    {
      "index": 35,
      "text": "हवा में अब शाम की लहर है - ताज़ी, लगभग मीठी।",
      "file": "c035.ogg",
      "durationSec": 8.088
    },
    {
      "index": 36,
      "text": "गेट को खोले बिना ही रुकें।",
      "file": "c036.ogg",
      "durationSec": 5.208
    },
    {
      "index": 37,
      "text": "महसूस करें कि कंधों में कितनी शांति बस गई है।",
      "file": "c037.ogg",
      "durationSec": 8.352
    },
    {
      "index": 38,
      "text": "बगीचे की शांति को एक छोटे लालटेन की तरह अंदर की ओर ले जाएं।",
      "file": "c038.ogg",
      "durationSec": 9.888
    },
    {
      "index": 39,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c039.ogg",
      "durationSec": 7.92
    },
    {
      "index": 40,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c040.ogg",
      "durationSec": 4.536
    },
    {
      "index": 41,
      "text": "धीरे-धीरे सांस छोड़ें।",
      "file": "c041.ogg",
      "durationSec": 4.704
    },
    {
      "index": 42,
      "text": "श्वास लें.",
      "file": "c042.ogg",
      "durationSec": 3.216
    },
    {
      "index": 43,
      "text": "साँस छोड़ें।",
      "file": "c043.ogg",
      "durationSec": 3.36
    },
    {
      "index": 44,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c044.ogg",
      "durationSec": 7.872
    },
    {
      "index": 45,
      "text": "जहां भी हवा ठंडी हो वहां ठंडक महसूस करें।",
      "file": "c045.ogg",
      "durationSec": 7.464
    },
    {
      "index": 46,
      "text": "श्वास लें.",
      "file": "c046.ogg",
      "durationSec": 3.216
    },
    {
      "index": 47,
      "text": "साँस छोड़ें।",
      "file": "c047.ogg",
      "durationSec": 3.36
    },
    {
      "index": 48,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c048.ogg",
      "durationSec": 9.288
    },
    {
      "index": 49,
      "text": "श्वास लें.",
      "file": "c049.ogg",
      "durationSec": 3.216
    },
    {
      "index": 50,
      "text": "साँस छोड़ें।",
      "file": "c050.ogg",
      "durationSec": 3.36
    },
    {
      "index": 51,
      "text": "कुछ शांत सांसों के लिए यहां आराम करें।",
      "file": "c051.ogg",
      "durationSec": 6.624
    },
    {
      "index": 52,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c052.ogg",
      "durationSec": 8.976
    },
    {
      "index": 53,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c053.ogg",
      "durationSec": 6.696
    },
    {
      "index": 54,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c054.ogg",
      "durationSec": 6.024
    },
    {
      "index": 55,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c055.ogg",
      "durationSec": 5.208
    },
    {
      "index": 56,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c056.ogg",
      "durationSec": 7.008
    }
  ]
}
