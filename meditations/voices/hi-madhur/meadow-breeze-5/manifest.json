{
  "id": "meadow-breeze-5",
  "voiceId": "hi-madhur",
  "edgeVoice": "hi-IN-MadhurNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 425,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.192
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 5.016
    },
    {
      "index": 3,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c003.ogg",
      "durationSec": 9.048
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.808
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 5.904
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 5.736
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 5.928
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.536
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.328
    },
    {
      "index": 10,
      "text": "देर सुबह एक विस्तृत पहाड़ी घास के मैदान की कल्पना करें।",
      "file": "c010.ogg",
      "durationSec": 8.832
    },
    {
      "index": 11,
      "text": "लंबी घासें आसान लहरों में लहराती हैं।",
      "file": "c011.ogg",
      "durationSec": 7.8
    },
    {
      "index": 12,
      "text": "सूरज तेज़ न होते हुए भी गर्म है।",
      "file": "c012.ogg",
      "durationSec": 7.008
    },
    {
      "index": 13,
      "text": "इसे अपने सिर के शीर्ष पर महसूस करें, दयालु और स्थिर।",
      "file": "c013.ogg",
      "durationSec": 8.76
    },
    {
      "index": 14,
      "text": "एक ताज़ी हवा घास से होकर गुजरती है और आपका चेहरा ढूंढती है।",
      "file": "c014.ogg",
      "durationSec": 11.424
    },
    {
      "index": 15,
      "text": "इसमें जंगली फूलों और धूप में सूखी धरती की खुशबू आती है।",
      "file": "c015.ogg",
      "durationSec": 9.84
    },
    {
      "index": 16,
      "text": "You walk slowly, fingertips brushing seed heads.",
      "file": "c016.ogg",
      "durationSec": 7.08
    },
    {
      "index": 17,
      "text": "Soft tickle. Soft sound.",
      "file": "c017.ogg",
      "durationSec": 6.192
    },
    {
      "index": 18,
      "text": "Butterflies lift and settle again, unhurried.",
      "file": "c018.ogg",
      "durationSec": 7.296
    },
    {
      "index": 19,
      "text": "आपको घास में लेटने के लिए जगह मिल जाती है।",
      "file": "c019.ogg",
      "durationSec": 7.92
    },
    {
      "index": 20,
      "text": "पृथ्वी तुम्हारी सारी लम्बाई को धारण करती है।",
      "file": "c020.ogg",
      "durationSec": 7.728
    },
    {
      "index": 21,
      "text": "आपके सामने गर्मजोशी। आपके किनारों पर ठंडी मिट्टी-छाया।",
      "file": "c021.ogg",
      "durationSec": 10.656
    },
    {
      "index": 22,
      "text": "हवा दोस्ताना ज्वार की तरह आती और चली जाती है।",
      "file": "c022.ogg",
      "durationSec": 8.808
    },
    {
      "index": 23,
      "text": "ताजगी का श्वास लें। खुले आसमान में सांस छोड़ें।",
      "file": "c023.ogg",
      "durationSec": 9.768
    },
    {
      "index": 24,
      "text": "A cloud slides across the sun for a moment.",
      "file": "c024.ogg",
      "durationSec": 6.72
    },
    {
      "index": 25,
      "text": "Coolness. Then warmth returns to your face.",
      "file": "c025.ogg",
      "durationSec": 8.184
    },
    {
      "index": 26,
      "text": "Notice how large the quiet feels.",
      "file": "c026.ogg",
      "durationSec": 5.448
    },
    {
      "index": 27,
      "text": "How small any worry seems in this wide field.",
      "file": "c027.ogg",
      "durationSec": 7.176
    },
    {
      "index": 28,
      "text": "आपके हाथ घास में आराम कर रहे हैं। छोटे-छोटे तने प्यार से दबाएँ।",
      "file": "c028.ogg",
      "durationSec": 12.432
    },
    {
      "index": 29,
      "text": "अपनी बंद आंखों पर सूरज की गर्माहट बरकरार रखें।",
      "file": "c029.ogg",
      "durationSec": 8.208
    },
    {
      "index": 30,
      "text": "Stay with the soft press of grass against your arms.",
      "file": "c030.ogg",
      "durationSec": 7.728
    },
    {
      "index": 31,
      "text": "आपको अभी भी ऐसा ही रहने की अनुमति है।",
      "file": "c031.ogg",
      "durationSec": 7.8
    },
    {
      "index": 32,
      "text": "कुछ और चक्रों के लिए घास के मैदान को आपको सांस लेने दें।",
      "file": "c032.ogg",
      "durationSec": 9.168
    },
    {
      "index": 33,
      "text": "Roll your attention from the warm crown of the head",
      "file": "c033.ogg",
      "durationSec": 7.032
    },
    {
      "index": 34,
      "text": "down through a soft face, a soft throat,",
      "file": "c034.ogg",
      "durationSec": 6.408
    },
    {
      "index": 35,
      "text": "एक ऐसे संदूक में जो खुले आसमान के नीचे आसानी से उठ जाता है।",
      "file": "c035.ogg",
      "durationSec": 11.064
    },
    {
      "index": 36,
      "text": "हवा आपकी कलाइयों के अंदर का पता लगा लेती है।",
      "file": "c036.ogg",
      "durationSec": 8.256
    },
    {
      "index": 37,
      "text": "ठंडा। जीवित। दोस्ताना।",
      "file": "c037.ogg",
      "durationSec": 8.112
    },
    {
      "index": 38,
      "text": "कहीं-कहीं मधुमक्खियाँ बिना किसी तात्कालिकता के काम करती हैं।",
      "file": "c038.ogg",
      "durationSec": 9.648
    },
    {
      "index": 39,
      "text": "उनकी गुनगुनाहट एक अन्य प्रकार की शांति है।",
      "file": "c039.ogg",
      "durationSec": 7.848
    },
    {
      "index": 40,
      "text": "तब तक बने रहें जब तक गर्माहट और ताजगी एक कपड़े की तरह महसूस न हो जाए।",
      "file": "c040.ogg",
      "durationSec": 11.52
    },
    {
      "index": 41,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c041.ogg",
      "durationSec": 7.92
    },
    {
      "index": 42,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c042.ogg",
      "durationSec": 4.536
    },
    {
      "index": 43,
      "text": "Exhale slowly.",
      "file": "c043.ogg",
      "durationSec": 3.72
    },
    {
      "index": 44,
      "text": "श्वास लें.",
      "file": "c044.ogg",
      "durationSec": 3.216
    },
    {
      "index": 45,
      "text": "साँस छोड़ें।",
      "file": "c045.ogg",
      "durationSec": 3.36
    },
    {
      "index": 46,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c046.ogg",
      "durationSec": 7.872
    },
    {
      "index": 47,
      "text": "Feel coolness wherever the air is cool.",
      "file": "c047.ogg",
      "durationSec": 6.408
    },
    {
      "index": 48,
      "text": "Inhale.",
      "file": "c048.ogg",
      "durationSec": 2.736
    },
    {
      "index": 49,
      "text": "साँस छोड़ें।",
      "file": "c049.ogg",
      "durationSec": 3.36
    },
    {
      "index": 50,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c050.ogg",
      "durationSec": 9.288
    },
    {
      "index": 51,
      "text": "श्वास लें.",
      "file": "c051.ogg",
      "durationSec": 3.216
    },
    {
      "index": 52,
      "text": "Exhale.",
      "file": "c052.ogg",
      "durationSec": 2.76
    },
    {
      "index": 53,
      "text": "Rest here for a few quiet breaths.",
      "file": "c053.ogg",
      "durationSec": 5.448
    },
    {
      "index": 54,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c054.ogg",
      "durationSec": 8.976
    },
    {
      "index": 55,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c055.ogg",
      "durationSec": 6.696
    },
    {
      "index": 56,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c056.ogg",
      "durationSec": 6.024
    },
    {
      "index": 57,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c057.ogg",
      "durationSec": 5.208
    },
    {
      "index": 58,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c058.ogg",
      "durationSec": 7.008
    }
  ]
}
