{
  "id": "body-scan",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 172,
  "chunks": [
    {
      "index": 0,
      "text": "We will gently scan the body.",
      "file": "c000.ogg",
      "durationSec": 4.992
    },
    {
      "index": 1,
      "text": "आराम से लेटें या बैठें।",
      "file": "c001.ogg",
      "durationSec": 5.04
    },
    {
      "index": 2,
      "text": "Close your eyes if that feels safe.",
      "file": "c002.ogg",
      "durationSec": 5.664
    },
    {
      "index": 3,
      "text": "Begin at the crown of the head.",
      "file": "c003.ogg",
      "durationSec": 4.776
    },
    {
      "index": 4,
      "text": "वहां किसी भी अनुभूति पर ध्यान दें। गर्मी। शीतलता. कुछ भी नहीं।",
      "file": "c004.ogg",
      "durationSec": 15.408
    },
    {
      "index": 5,
      "text": "इसे बदलने की कोई जरूरत नहीं है. जरा गौर करें.",
      "file": "c005.ogg",
      "durationSec": 10.032
    },
    {
      "index": 6,
      "text": "धीरे से माथे और आंखों की ओर ले जाएं।",
      "file": "c006.ogg",
      "durationSec": 7.296
    },
    {
      "index": 7,
      "text": "Let the tiny muscles around the eyes soften.",
      "file": "c007.ogg",
      "durationSec": 6.648
    },
    {
      "index": 8,
      "text": "जबड़े को महसूस करो. यदि आप कर सकते हैं तो खोल दें।",
      "file": "c008.ogg",
      "durationSec": 10.776
    },
    {
      "index": 9,
      "text": "जीभ हल्का आराम कर रही है।",
      "file": "c009.ogg",
      "durationSec": 5.016
    },
    {
      "index": 10,
      "text": "Shoulders. Are they lifted? Let them drop a little.",
      "file": "c010.ogg",
      "durationSec": 10.68
    },
    {
      "index": 11,
      "text": "Arms heavy. Hands open or soft.",
      "file": "c011.ogg",
      "durationSec": 7.44
    },
    {
      "index": 12,
      "text": "Chest rising and falling with breath.",
      "file": "c012.ogg",
      "durationSec": 5.424
    },
    {
      "index": 13,
      "text": "पेट मुलायम. कोई जबरदस्ती नहीं.",
      "file": "c013.ogg",
      "durationSec": 8.04
    },
    {
      "index": 14,
      "text": "Hips and pelvis resting.",
      "file": "c014.ogg",
      "durationSec": 4.512
    },
    {
      "index": 15,
      "text": "Thighs. Knees. Lower legs.",
      "file": "c015.ogg",
      "durationSec": 8.88
    },
    {
      "index": 16,
      "text": "पैर। तलवे फर्श या चटाई को छूते हुए।",
      "file": "c016.ogg",
      "durationSec": 8.352
    },
    {
      "index": 17,
      "text": "अब पूरे शरीर को जागरूकता के एक क्षेत्र के रूप में महसूस करें।",
      "file": "c017.ogg",
      "durationSec": 9.648
    },
    {
      "index": 18,
      "text": "इसके माध्यम से सांस चल रही है।",
      "file": "c018.ogg",
      "durationSec": 5.712
    },
    {
      "index": 19,
      "text": "If a tense spot appears, send a kind exhale there.",
      "file": "c019.ogg",
      "durationSec": 8.04
    },
    {
      "index": 20,
      "text": "तीन शांत सांसों के लिए रुकें।",
      "file": "c020.ogg",
      "durationSec": 5.4
    },
    {
      "index": 21,
      "text": "When you are ready, wiggle fingers and toes.",
      "file": "c021.ogg",
      "durationSec": 6.648
    },
    {
      "index": 22,
      "text": "Open your eyes. Return gently.",
      "file": "c022.ogg",
      "durationSec": 7.272
    }
  ]
}
