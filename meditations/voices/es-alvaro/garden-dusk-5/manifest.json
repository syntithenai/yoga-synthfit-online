{
  "id": "garden-dusk-5",
  "voiceId": "es-alvaro",
  "edgeVoice": "es-ES-AlvaroNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 336,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.048
    },
    {
      "index": 1,
      "text": "Tome un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c001.ogg",
      "durationSec": 6.888
    },
    {
      "index": 2,
      "text": "Deja que tus manos descansen.",
      "file": "c002.ogg",
      "durationSec": 4.728
    },
    {
      "index": 3,
      "text": "Deja que tus ojos se cierren o suaviza tu mirada.",
      "file": "c003.ogg",
      "durationSec": 6.336
    },
    {
      "index": 4,
      "text": "Observe el peso de su cuerpo que se sostiene.",
      "file": "c004.ogg",
      "durationSec": 5.736
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 4.944
    },
    {
      "index": 6,
      "text": "Y una exhalación más larga y más fácil.",
      "file": "c006.ogg",
      "durationSec": 5.568
    },
    {
      "index": 7,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c007.ogg",
      "durationSec": 6.648
    },
    {
      "index": 8,
      "text": "Exhala suavemente.",
      "file": "c008.ogg",
      "durationSec": 3.888
    },
    {
      "index": 9,
      "text": "Si los pensamientos divagan, está bien. Vuelve a la respiración.",
      "file": "c009.ogg",
      "durationSec": 9.504
    },
    {
      "index": 10,
      "text": "Imagínese un tranquilo jardín amurallado al suave atardecer.",
      "file": "c010.ogg",
      "durationSec": 7.224
    },
    {
      "index": 11,
      "text": "Los caminos de piedra retienen el último calor del día.",
      "file": "c011.ogg",
      "durationSec": 6.696
    },
    {
      "index": 12,
      "text": "Feel that gentle heat through the soles of your feet.",
      "file": "c012.ogg",
      "durationSec": 5.928
    },
    {
      "index": 13,
      "text": "La lavanda y las rosas vespertinas liberan una fragancia tranquila.",
      "file": "c013.ogg",
      "durationSec": 7.656
    },
    {
      "index": 14,
      "text": "Una brisa fresca se desliza por la pared y refresca tu cuello.",
      "file": "c014.ogg",
      "durationSec": 7.296
    },
    {
      "index": 15,
      "text": "El aire es fresco después de una tarde cálida.",
      "file": "c015.ogg",
      "durationSec": 6.168
    },
    {
      "index": 16,
      "text": "Caminas lentamente entre setos recortados suaves como el aliento.",
      "file": "c016.ogg",
      "durationSec": 7.776
    },
    {
      "index": 17,
      "text": "Tus dedos rozan las hojas que aún sostienen el sol.",
      "file": "c017.ogg",
      "durationSec": 6.408
    },
    {
      "index": 18,
      "text": "Cálido. Liso. Vivo.",
      "file": "c018.ogg",
      "durationSec": 7.488
    },
    {
      "index": 19,
      "text": "A wooden bench waits beneath a quiet tree.",
      "file": "c019.ogg",
      "durationSec": 5.496
    },
    {
      "index": 20,
      "text": "Te sientas. La madera resulta agradablemente cálida en la espalda.",
      "file": "c020.ogg",
      "durationSec": 9.672
    },
    {
      "index": 21,
      "text": "Arriba, el cielo se vuelve lavanda y rosa.",
      "file": "c021.ogg",
      "durationSec": 6.432
    },
    {
      "index": 22,
      "text": "Los pájaros se posan. El jardín se vuelve silencioso.",
      "file": "c022.ogg",
      "durationSec": 8.856
    },
    {
      "index": 23,
      "text": "Siente la calidez que se desvanece amablemente en la piedra y la madera.",
      "file": "c023.ogg",
      "durationSec": 8.04
    },
    {
      "index": 24,
      "text": "Feel the freshening cool of evening on your face.",
      "file": "c024.ogg",
      "durationSec": 5.616
    },
    {
      "index": 25,
      "text": "Inhala aroma y quietud.",
      "file": "c025.ogg",
      "durationSec": 3.792
    },
    {
      "index": 26,
      "text": "Exhale the day you carried in.",
      "file": "c026.ogg",
      "durationSec": 4.344
    },
    {
      "index": 27,
      "text": "Una polilla atraviesa la última luz dorada.",
      "file": "c027.ogg",
      "durationSec": 5.952
    },
    {
      "index": 28,
      "text": "Aquí nada es urgente. Todo es suficiente.",
      "file": "c028.ogg",
      "durationSec": 7.8
    },
    {
      "index": 29,
      "text": "Descansa en esa suficiente.",
      "file": "c029.ogg",
      "durationSec": 4.752
    },
    {
      "index": 30,
      "text": "Deja que tu vientre se ablande con el aire del atardecer.",
      "file": "c030.ogg",
      "durationSec": 6.576
    },
    {
      "index": 31,
      "text": "Let your next breath be the quietest of the day.",
      "file": "c031.ogg",
      "durationSec": 6.216
    },
    {
      "index": 32,
      "text": "Camine un bucle lento por el sendero antes de terminar.",
      "file": "c032.ogg",
      "durationSec": 6.648
    },
    {
      "index": 33,
      "text": "Piedras cálidas que se enfrían bajo los pies.",
      "file": "c033.ogg",
      "durationSec": 5.856
    },
    {
      "index": 34,
      "text": "Hedges releasing the day’s stored perfume.",
      "file": "c034.ogg",
      "durationSec": 5.448
    },
    {
      "index": 35,
      "text": "La brisa ahora tiene un toque vespertino: fresca, casi dulce.",
      "file": "c035.ogg",
      "durationSec": 8.544
    },
    {
      "index": 36,
      "text": "Pause at the gate without opening it yet.",
      "file": "c036.ogg",
      "durationSec": 5.424
    },
    {
      "index": 37,
      "text": "Feel how calm has settled into the shoulders.",
      "file": "c037.ogg",
      "durationSec": 5.784
    },
    {
      "index": 38,
      "text": "Lleva el silencio del jardín como una pequeña linterna hacia el interior.",
      "file": "c038.ogg",
      "durationSec": 7.824
    },
    {
      "index": 39,
      "text": "Ahora descansa un rato en la respiración a solas.",
      "file": "c039.ogg",
      "durationSec": 6.6
    },
    {
      "index": 40,
      "text": "Inhala lentamente.",
      "file": "c040.ogg",
      "durationSec": 3.792
    },
    {
      "index": 41,
      "text": "Exhala lentamente.",
      "file": "c041.ogg",
      "durationSec": 3.816
    },
    {
      "index": 42,
      "text": "Inhale.",
      "file": "c042.ogg",
      "durationSec": 2.664
    },
    {
      "index": 43,
      "text": "Exhalar.",
      "file": "c043.ogg",
      "durationSec": 2.784
    },
    {
      "index": 44,
      "text": "Siente calidez dondequiera que el cuerpo esté caliente.",
      "file": "c044.ogg",
      "durationSec": 6.624
    },
    {
      "index": 45,
      "text": "Siente frescura dondequiera que el aire esté fresco.",
      "file": "c045.ogg",
      "durationSec": 6.552
    },
    {
      "index": 46,
      "text": "Inhalar.",
      "file": "c046.ogg",
      "durationSec": 2.664
    },
    {
      "index": 47,
      "text": "Exhalar.",
      "file": "c047.ogg",
      "durationSec": 2.784
    },
    {
      "index": 48,
      "text": "Ningún lugar adonde ir. Nada que arreglar.",
      "file": "c048.ogg",
      "durationSec": 7.32
    },
    {
      "index": 49,
      "text": "Inhalar.",
      "file": "c049.ogg",
      "durationSec": 2.664
    },
    {
      "index": 50,
      "text": "Exhalar.",
      "file": "c050.ogg",
      "durationSec": 2.784
    },
    {
      "index": 51,
      "text": "Descanse aquí durante unas cuantas respiraciones tranquilas.",
      "file": "c051.ogg",
      "durationSec": 7.392
    },
    {
      "index": 52,
      "text": "Sepa que puede regresar a este lugar en cualquier momento.",
      "file": "c052.ogg",
      "durationSec": 7.008
    },
    {
      "index": 53,
      "text": "Cuando estés listo, profundiza la respiración.",
      "file": "c053.ogg",
      "durationSec": 6.408
    },
    {
      "index": 54,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c054.ogg",
      "durationSec": 5.424
    },
    {
      "index": 55,
      "text": "Abre los ojos suavemente.",
      "file": "c055.ogg",
      "durationSec": 4.464
    },
    {
      "index": 56,
      "text": "Lleva un poco de esta paz contigo.",
      "file": "c056.ogg",
      "durationSec": 5.064
    }
  ]
}
