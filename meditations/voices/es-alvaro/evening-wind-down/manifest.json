{
  "id": "evening-wind-down",
  "voiceId": "es-alvaro",
  "edgeVoice": "es-ES-AlvaroNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 135,
  "chunks": [
    {
      "index": 0,
      "text": "Esta práctica es para el final del día.",
      "file": "c000.ogg",
      "durationSec": 5.328
    },
    {
      "index": 1,
      "text": "Atenúa las luces si puedes.",
      "file": "c001.ogg",
      "durationSec": 4.536
    },
    {
      "index": 2,
      "text": "Acuéstese o recuéstese con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.04
    },
    {
      "index": 3,
      "text": "Deja que el día termine, incluso si la mente todavía enumera tareas.",
      "file": "c003.ogg",
      "durationSec": 8.496
    },
    {
      "index": 4,
      "text": "Puedes dejarlos por ahora.",
      "file": "c004.ogg",
      "durationSec": 4.128
    },
    {
      "index": 5,
      "text": "Inhale suavemente mientras cuenta hasta cuatro.",
      "file": "c005.ogg",
      "durationSec": 5.904
    },
    {
      "index": 6,
      "text": "Exhale for a count of six.",
      "file": "c006.ogg",
      "durationSec": 4.416
    },
    {
      "index": 7,
      "text": "De nuevo. Cuatro adentro. Seis afuera.",
      "file": "c007.ogg",
      "durationSec": 9.144
    },
    {
      "index": 8,
      "text": "Las exhalaciones más largas le indican al cuerpo que es seguro descansar.",
      "file": "c008.ogg",
      "durationSec": 8.448
    },
    {
      "index": 9,
      "text": "Busque restos de tensión en la cara.",
      "file": "c009.ogg",
      "durationSec": 4.992
    },
    {
      "index": 10,
      "text": "Soften the brow. Soften the jaw.",
      "file": "c010.ogg",
      "durationSec": 6.576
    },
    {
      "index": 11,
      "text": "Drop the shoulders away from the ears.",
      "file": "c011.ogg",
      "durationSec": 5.112
    },
    {
      "index": 12,
      "text": "Imagínese el día asentándose como polvo después de una brisa.",
      "file": "c012.ogg",
      "durationSec": 7.464
    },
    {
      "index": 13,
      "text": "Lo que pasó, pasó.",
      "file": "c013.ogg",
      "durationSec": 4.152
    },
    {
      "index": 14,
      "text": "Lo que quede puede esperar hasta la mañana.",
      "file": "c014.ogg",
      "durationSec": 5.4
    },
    {
      "index": 15,
      "text": "Siente el colchón o el suelo sosteniéndote.",
      "file": "c015.ogg",
      "durationSec": 5.832
    },
    {
      "index": 16,
      "text": "Respira más tranquilo. Cuerpo más pesado.",
      "file": "c016.ogg",
      "durationSec": 7.608
    },
    {
      "index": 17,
      "text": "Si llega el sueño, déjalo.",
      "file": "c017.ogg",
      "durationSec": 4.776
    },
    {
      "index": 18,
      "text": "Si no, descansa de todos modos en esta suavidad.",
      "file": "c018.ogg",
      "durationSec": 6.744
    },
    {
      "index": 19,
      "text": "Tres respiraciones lentas más.",
      "file": "c019.ogg",
      "durationSec": 4.776
    },
    {
      "index": 20,
      "text": "En. Afuera.",
      "file": "c020.ogg",
      "durationSec": 2.904
    },
    {
      "index": 21,
      "text": "En. Afuera.",
      "file": "c021.ogg",
      "durationSec": 2.904
    },
    {
      "index": 22,
      "text": "En. Afuera.",
      "file": "c022.ogg",
      "durationSec": 2.904
    },
    {
      "index": 23,
      "text": "Buenas noches al día. Paz a la noche.",
      "file": "c023.ogg",
      "durationSec": 7.104
    }
  ]
}
