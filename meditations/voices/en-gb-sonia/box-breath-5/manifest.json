      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Again. Inhale.",
      "file": "c015.ogg",
      "durationSec": 3.672
    },
    {
      "index": 16,
      "text": "Hold.",
      "file": "c016.ogg",
      "durationSec": 1.752
    },
    {
      "index": 17,
      "text": "Exhale.",
      "file": "c017.ogg",
      "durationSec": 1.992
    },
    {
      "index": 18,
