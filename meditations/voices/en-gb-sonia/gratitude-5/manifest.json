{
  "id": "gratitude-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 305,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.896
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 6.984
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 3.216
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 4.392
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 3.144
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 3.192
    },
    {
      "index": 6,
      "text": "Bring to mind one small thing that helped you today, or this week.",
      "file": "c006.ogg",
      "durationSec": 7.392
    },
    {
      "index": 7,
      "text": "It can be ordinary. Warm water. A message. Light on a wall.",
      "file": "c007.ogg",
      "durationSec": 9.744
    },
    {
      "index": 8,
      "text": "[pause:21]",
      "file": "c008.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 9,
      "text": "Hold it gently in awareness.",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Notice any softening in the chest or face.",
      "file": "c010.ogg",
      "durationSec": 5.592
    },
    {
      "index": 11,
      "text": "[pause:26]",
      "file": "c011.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 12,
      "text": "Silently, thank this one thing.",
      "file": "c012.ogg",
      "durationSec": 4.536
    },
    {
      "index": 13,
      "text": "Thank you for being here.",
      "file": "c013.ogg",
      "durationSec": 3.264
    },
    {
      "index": 14,
      "text": "[pause:21]",
      "file": "c014.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Now a second thing. Another small good.",
      "file": "c015.ogg",
      "durationSec": 5.76
    },
    {
      "index": 16,
      "text": "[pause:26]",
      "file": "c016.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Thank you.",
      "file": "c017.ogg",
      "durationSec": 1.992
    },
    {
      "index": 18,
      "text": "[pause:15]",
      "file": "c018.ogg",
      "durationSec": 15.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "And one more. A third.",
      "file": "c019.ogg",
      "durationSec": 4.152
    },
    {
      "index": 20,
      "text": "[pause:26]",
      "file": "c020.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Let gratitude be simple. Not forced. Just noticed.",
      "file": "c021.ogg",
      "durationSec": 8.664
    },
    {
      "index": 22,
      "text": "[pause:31]",
      "file": "c022.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Rest in that warmth for a few breaths.",
      "file": "c023.ogg",
      "durationSec": 4.776
    },
    {
      "index": 24,
      "text": "[pause:41]",
      "file": "c024.ogg",
      "durationSec": 41.0,
      "silence": true
    },
    {
      "index": 25,
      "text": "Take one more easy breath.",
      "file": "c025.ogg",
      "durationSec": 3.696
    },
    {
      "index": 26,
      "text": "Wiggle the fingers.",
      "file": "c026.ogg",
      "durationSec": 2.928
    },
    {
      "index": 27,
      "text": "When you are ready, open the eyes.",
      "file": "c027.ogg",
      "durationSec": 4.368
    },
    {
      "index": 28,
      "text": "Carry a little of this with you.",
      "file": "c028.ogg",
      "durationSec": 3.744
    }
  ],
  "engine": "edge",
  "note": "edge-tts bake for practice pack; optional elevenlabs re-bake later"
}
